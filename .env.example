# Sunset Messages — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get this from your Neon project dashboard → Connection string (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Session ───────────────────────────────────────────────────────────────────
# Any long random string (≥32 chars). Used to namespace the session cookie.
SESSION_SECRET="replace-me-with-a-very-long-random-secret-string-32chars-min"
SUN_PASSCODE="set-a-unique-long-random-passcode"
MOON_PASSCODE="set-a-different-long-random-passcode"

# ── Web Push / VAPID ──────────────────────────────────────────────────────────
# Generate these once with:  node scripts/generate-vapid.mjs
#
# NEXT_PUBLIC_ prefix makes the public key available to browser code.
# The private key MUST remain server-side only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-base64url-vapid-public-key"
VAPID_PRIVATE_KEY="your-base64url-vapid-private-key"
# Must be a mailto: or https: URL (identifies your app to push services)
VAPID_SUBJECT="mailto:you@yourdomain.com"

# ── Cron Security ─────────────────────────────────────────────────────────────
# Used as a bearer token to authenticate calls to /api/cron/check-deliveries.
# Generate with:  openssl rand -hex 32
# Set as an Environment Variable in Vercel, and as a Cron Job header secret.
CRON_SECRET="replace-with-a-long-random-hex-string"
